GROQ_MODEL=qwen/qwen3.8-27b
GROQ_API_KEY=
SARVAM_API_KEY=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
# Optional legacy SMTP workflow
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Local hourly admitted writing requests per client (1–100)
WRITING_REQUESTS_PER_HOUR=20

# Public deployment: no invite required; durable shared daily quota
APP_ENV=development
PILOT_ACCESS_REQUIRED=false
PUBLIC_REQUESTS_PER_DAY=100
# Production enables a persistent three-attempt browser demo by default.
# Development leaves it off unless explicitly enabled.
# DEMO_LIMIT_ENABLED=true
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
